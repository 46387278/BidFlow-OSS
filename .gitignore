# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/

# ---- 运行产物（不进仓库）----
output/*
!output/README.txt
*.db
*.db-journal
*.part

# ---- 雷达运行产物：状态、日志、报告都是本机的事 ----
collector/state/
collector/output/
data/reports/
data/requirements.csv
data/requirements.csv.bak-*
data/manual_overrides.json
!data/requirements.example.csv

# ---- 本机配置（config.example.json 才是模板）----
config/config.json

# ---- 生成物：样本 docx 由 tools/make_sample_bid.py 生成 ----
# 说明：这里故意忽略生成的样本，让 CI 每次自己生成，
# 从而保证「引擎能吃这份样本」这件事每次都被验证，而不是靠一个陈年二进制。
data/sample/*.docx

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log

# ---- 打包产物：发布用 GitHub Releases，不进版本库 ----
dist/
BidFlow-OSS*.zip
BidFlow-OSS*.bundle
